# apps/api/.env
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.uke.local
AUTH0_ROLE_CLAIM=https://uke.local/rol
AUTH0_M2M_CLIENT_ID=your-auth0-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-auth0-m2m-client-secret
AUTH0_M2M_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/
CORS_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=uke-fotos
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UKE App <noreply@uke.local>
APP_BASE_URL=http://localhost:3000
TZ=Europe/Madrid

# apps/web/.env
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.uke.local
VITE_API_URL=http://localhost:3001
