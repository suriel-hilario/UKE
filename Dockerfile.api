FROM node:22-alpine

WORKDIR /app

# Copy pnpm installation
COPY pnpm/10.30.0/libexec/lib/node_modules/pnpm /usr/local/lib/node_modules/pnpm
RUN ln -s /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm

EXPOSE 3001

# Simple startup - NestJS doesn't have cross-platform native dependencies
CMD pnpm --filter @workspace/api dev
