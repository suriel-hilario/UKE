# Copy to .env.test (repo root) for local e2e runs. NEVER commit .env.test.
# In CI, the equivalent of this file is base64-decoded from the E2E_ENV_PROD
# secret (see design.md D6) — it must have the SAME shape as .env.prod, since
# it's passed as --env-file to `docker compose -f docker-compose.prod.yml`.

# --- Auth0 (same tenant as dev/prod; e2e uses dedicated test users, see below) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.uke.local
AUTH0_ROLE_CLAIM=https://uke.local/rol
AUTH0_M2M_CLIENT_ID=your-auth0-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-auth0-m2m-client-secret
AUTH0_M2M_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/

# --- Auth0 (frontend build-time) ---
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.uke.local
VITE_API_URL=/api

# --- Database ---
POSTGRES_USER=uke_e2e
POSTGRES_PASSWORD=uke_e2e
POSTGRES_DB=uke_e2e
DATABASE_URL=postgresql://uke_e2e:uke_e2e@postgres:5432/uke_e2e

# --- Storage (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=uke-fotos-e2e
S3_ACCESS_KEY=uke_e2e_minio
S3_SECRET_KEY=uke_e2e_minio_secret
S3_REGION=us-east-1

# --- Email (not exercised by e2e; notificaciones is out of scope, see design.md) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UKE e2e <noreply@uke.local>

# --- App ---
CORS_ORIGIN=https://localhost
APP_BASE_URL=https://localhost
TZ=Europe/Madrid
NODE_ENV=production

# =============================================================================
# The vars below are consumed by e2e/global-setup.ts and e2e/support/*.ts
# directly (Playwright's Node process), NOT by docker-compose.prod.yml, and
# are forwarded explicitly into the api container for seeding. They are
# real Auth0 test users created for this purpose, with MFA skipped via an
# app_metadata.skip_mfa Auth0 rule (see design.md D1 and openspec/specs/
# e2e-testing/spec.md "MFA does not block automated login").
# =============================================================================

E2E_ADMIN_EMAIL=e2e-test+admin@uke.local
E2E_ADMIN_PASSWORD=
E2E_ADMIN_AUTH0_ID=auth0|...

E2E_DIRECTOR_EMAIL=e2e-test+director@uke.local
E2E_DIRECTOR_PASSWORD=
E2E_DIRECTOR_AUTH0_ID=auth0|...

E2E_COORDINADOR_EMAIL=e2e-test+coordinador@uke.local
E2E_COORDINADOR_PASSWORD=
E2E_COORDINADOR_AUTH0_ID=auth0|...

E2E_ENTRENADOR_EMAIL=e2e-test+entrenador@uke.local
E2E_ENTRENADOR_PASSWORD=
E2E_ENTRENADOR_AUTH0_ID=auth0|...
